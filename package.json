{
  "name": "joshua-nwachinemere-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "postbuild": "node scripts/apply-pages-environment.mjs && npm run build:pages-functions",
    "build:pages-functions": "node scripts/build-pages-worker.mjs",
    "build:assets": "python scripts/build_assets.py && node scripts/build-social-card.js",
    "preview": "vite preview --host 0.0.0.0",
    "assistant:sync-corpus": "node scripts/sync-assistant-corpus.mjs",
    "qa:assistant:detailed": "node scripts/qa-detailed-rag.mjs",
    "test": "node --test tests/*.test.js && python -m unittest discover -s tests -p 'test_cv_artifact.py' -v",
    "pretest:e2e": "npm run build",
    "test:e2e": "node scripts/run-playwright.js tests/e2e/alternative.spec.js",
    "check": "npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "vite": "^7.0.0",
    "wrangler": "4.118.0"
  }
}
